    classDef model fill:#cce5ff,stroke:#b8daff,stroke-width:2px,color:#004085;
    classDef latent fill:#fff3cd,stroke:#ffeeba,stroke-width:2px,color:#856404;
    classDef codebook fill:#e2d9f3,stroke:#d6c8f0,stroke-width:2px,color:#492b7c;
    classDef loss fill:#f8d7da,stroke:#f5c6cb,stroke-width:2px,color:#721c24;

    class A,H io;
    class B,D,G model;
    class C,F latent;
