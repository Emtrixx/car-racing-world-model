flowchart TD
    subgraph VQ-VAE Architecture
        A["Input Image Batch<br/>(B, 3, 64, 64)"] --> B(Encoder);
        B -- " Downsamples to 4x4 grid " --> C["Continuous Latent Map<br/>(B, 256, 4, 4)"];
        C --> D(VectorQuantizerEMA);
        subgraph Codebook
            E["Embedding Vectors<br/>(512, 256)"];
        end
        D -- " Finds nearest vector for each grid cell " --> E;
        D -- " Outputs quantized map & indices " --> F["Quantized Latent Map<br/>(B, 256, 4, 4)"];
        F --> G(Decoder);
        G -- " Upsamples to 64x64 " --> H["Reconstructed Image<br/>(B, 3, 64, 64)"];
        subgraph Losses
            L1["Reconstruction Loss<br/>(MSE + Perceptual)"];
            L2["VQ Loss<br/>(Commitment Cost)"];
        end

        H -- " Compare " --> L1;
        A -- " Compare " --> L1;
        C -- " Compare " --> L2;
        F -- " Compare " --> L2;
    end


